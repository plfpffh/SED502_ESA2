# Vorlage für die lokale .env: kopieren mit  cp .env.example .env  und Werte eintragen.
# .env steht in .gitignore und wird nie committet. Auf Vercel als Umgebungsvariablen eintragen.

# Google Gemini API-Key aus https://aistudio.google.com/app/apikey (jede Person ihren eigenen, nicht weitergeben).
# Bewusst OHNE VITE_-Präfix: Er wird nur serverseitig in api/ki.ts gelesen und landet nie im Browser.
GEMINI_API_KEY=

# Optional: anderes Gemini-Modell, Standard siehe api/ki.ts
# GEMINI_MODEL=
